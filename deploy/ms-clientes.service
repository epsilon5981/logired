# /etc/systemd/system/ms-clientes.service
# Microservicio de clientes de LogiRed como servicio del sistema (puerto 3002, solo 127.0.0.1)
[Unit]
Description=Microservicio clientes - LogiRed
After=network.target

[Service]
User=nodeapps
Group=nodeapps
WorkingDirectory=/srv/logired/app/ms-clientes
ExecStart=/usr/bin/node --env-file=.env src/index.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
