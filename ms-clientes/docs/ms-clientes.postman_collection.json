{
  "info": {
    "name": "ms-clientes",
    "description": "Pruebas de ms-clientes (LogiRed). Base: http://localhost:3002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD (casos 1 a 13)",
      "item": [
        {
          "name": "1. Listar todos (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/clientes"
          }
        },
        {
          "name": "2. Filtrar por ciudad (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/clientes?ciudad=Cali"
          }
        },
        {
          "name": "3. Consultar por lotes ?ids= (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/clientes?ids=1,3"
          }
        },
        {
          "name": "4. Obtener un registro existente (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/clientes/2"
          }
        },
        {
          "name": "5. Obtener un id que no existe (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/clientes/99"
          }
        },
        {
          "name": "6. Obtener con id no numérico (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/clientes/abc"
          }
        },
        {
          "name": "7. Crear con datos válidos (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Café Quindío Ltda\",\n  \"nit\": \"900555111-3\",\n  \"email\": \"envios@cafequindio.co\",\n  \"telefono\": \"6067451200\",\n  \"ciudad\": \"Armenia\",\n  \"direccion\": \"Calle 21 # 14-30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('nuevo_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Crear sin nit (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente sin NIT\",\n  \"email\": \"contacto@sinnit.co\",\n  \"telefono\": \"6021112233\",\n  \"ciudad\": \"Cali\",\n  \"direccion\": \"Calle 5 # 10-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Crear con NIT repetido (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Duplicado\",\n  \"nit\": \"900123456-7\",\n  \"email\": \"otro@elvalle.com.co\",\n  \"telefono\": \"6023456700\",\n  \"ciudad\": \"Cali\",\n  \"direccion\": \"Calle 15 # 32-41\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Actualizar el registro creado (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clientes/{{nuevo_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Café Quindío S.A.S.\",\n  \"nit\": \"900555111-3\",\n  \"email\": \"envios@cafequindio.co\",\n  \"telefono\": \"6067451299\",\n  \"ciudad\": \"Armenia\",\n  \"direccion\": \"Calle 21 # 14-32\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Actualizar un id que no existe (404)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/clientes/99",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Café Quindío S.A.S.\",\n  \"nit\": \"900555111-3\",\n  \"email\": \"envios@cafequindio.co\",\n  \"telefono\": \"6067451299\",\n  \"ciudad\": \"Armenia\",\n  \"direccion\": \"Calle 21 # 14-32\",\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Eliminar el registro creado (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/clientes/{{nuevo_id}}"
          }
        },
        {
          "name": "13. Eliminar el mismo registro otra vez (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/clientes/{{nuevo_id}}"
          }
        }
      ]
    }
