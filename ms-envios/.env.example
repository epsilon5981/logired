# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio (ms-envios = 3003 según la tabla de asignación).
PORT=3003
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Base de datos MySQL del microservicio (en el Taller 3 DB_HOST será la IP de servidor1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=envios_db
DB_USER=envios_user
DB_PASSWORD=cambie-esta-clave

# Clave secreta para verificar los tokens JWT. Debe ser LA MISMA en todos los
# microservicios del grupo (incluido ms-usuarios). Nunca se sube al repositorio.
JWT_SECRET=cambie-esta-frase-secreta-larga
