{
  "info": {
    "name": "ms-envios",
    "description": "Pruebas de ms-envios (LogiRed). Base: http://localhost:3003.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD (casos 1 a 13)",
      "item": [
        {
          "name": "1. Listar todos (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/envios"
          }
        },
        {
          "name": "2. Filtrar por estado (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/envios?estado=registrado"
          }
        },
        {
          "name": "4. Obtener un registro existente (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/envios/3"
          }
        },
        {
          "name": "5. Obtener un id que no existe (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/envios/99"
          }
        },
        {
          "name": "6. Obtener con id no numérico (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/envios/abc"
          }
        },
        {
          "name": "7. Crear con datos válidos (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/envios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_guia\": \"LR-2026-000123\",\n  \"cliente_id\": 3,\n  \"peso_kg\": 2.5,\n  \"ciudad_destino\": \"Medellín\",\n  \"direccion_destino\": \"Carrera 43A # 1-50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('nuevo_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Crear sin cliente_id (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/envios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_guia\": \"LR-2026-000124\",\n  \"peso_kg\": 8,\n  \"ciudad_destino\": \"Bogotá\",\n  \"direccion_destino\": \"Calle 80 # 69-70\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Crear con número de guía repetido (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/envios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_guia\": \"LR-2026-000001\",\n  \"cliente_id\": 1,\n  \"peso_kg\": 1,\n  \"ciudad_destino\": \"Cali\",\n  \"direccion_destino\": \"Avenida 6N # 23-45\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Actualizar el registro creado (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/envios/{{nuevo_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_guia\": \"LR-2026-000123\",\n  \"cliente_id\": 3,\n  \"peso_kg\": 2.5,\n  \"ciudad_destino\": \"Medellín\",\n  \"direccion_destino\": \"Carrera 43A # 1-50\",\n  \"estado\": \"en_transito\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Actualizar un id que no existe (404)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/envios/99",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_guia\": \"LR-2026-000123\",\n  \"cliente_id\": 3,\n  \"peso_kg\": 2.5,\n  \"ciudad_destino\": \"Medellín\",\n  \"direccion_destino\": \"Carrera 43A # 1-50\",\n  \"estado\": \"en_transito\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Eliminar el registro creado (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/envios/{{nuevo_id}}"
          }
        },
        {
          "name": "13. Eliminar el mismo registro otra vez (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/envios/{{nuevo_id}}"
          }
        }
      ]
    }
  ],
